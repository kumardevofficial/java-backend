# Copy to .env and fill locally. Do not commit .env.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGINS=https://java-backend-interview-mcq.vercel.app,http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
AUTH_COOKIE_NAME=javaprep_access
# Set to none in production when frontend and API are on different sites. Omit locally for lax default.
# AUTH_COOKIE_SAME_SITE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

